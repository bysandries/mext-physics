---
import type { CollectionEntry } from 'astro:content';

export interface Props {
  topic: CollectionEntry<'topics'>;
}

const { topic } = Astro.props;
const data = topic.data;
---

<a href={`${import.meta.env.BASE_URL}topic/${data.id}`} class="topic-card">
  <div class="topic-card-header">
    <span class="topic-number">#{data.number}</span>
    {data.theoryOnly && <span class="badge">theory only</span>}
  </div>
  <h3 class="topic-title">{data.title.replace(/\[.*?\]/g, '').trim()}</h3>
  <div class="topic-meta">
    {data.problems.length > 0 && <span>{data.problems.length} {data.problems.length === 1 ? 'problem' : 'problems'}</span>}
    {data.formulas.length > 0 && <span>{data.formulas.length} formulas</span>}
  </div>
</a>

<style>
  .topic-card {
    display: flex; flex-direction: column; gap: 0.5rem;
    padding: 0.75rem 1rem; border-radius: var(--radius);
    border: 1px solid var(--border); background: var(--bg);
    transition: all 0.15s; text-decoration: none; color: var(--text);
  }
  .topic-card:hover {
    border-color: var(--accent); box-shadow: var(--shadow-sm);
    text-decoration: none;
  }
  .topic-card-header { display: flex; align-items: center; gap: 0.5rem; }
  .topic-number { font-size: 0.75rem; font-weight: 600; color: var(--text-muted); }
  .badge {
    font-size: 0.65rem; padding: 0.1rem 0.4rem;
    border-radius: 999px; background: var(--bg-secondary);
    color: var(--text-muted); border: 1px solid var(--border);
  }
  .topic-title { font-size: 0.9rem; font-weight: 600; line-height: 1.3; }
  .topic-meta { display: flex; gap: 0.75rem; font-size: 0.75rem; color: var(--text-muted); }
</style>
