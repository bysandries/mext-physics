---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FlashcardDeck from '../../components/study/FlashcardDeck.tsx';
import { getCollection } from 'astro:content';

const topics = await getCollection('topics');
const topicsJson = topics.map(t => t.data);
---

<BaseLayout title="Flashcards — MEXT Physics" description="Flashcard review for MEXT Physics exam">
  <div class="page">
    <h1>Flashcards</h1>
    <p class="page-desc">Review key formulas, concepts, and problem-solving steps with spaced repetition.</p>
    <FlashcardDeck topics={topicsJson} client:visible />
  </div>
</BaseLayout>

<style>
  .page { max-width: 700px; margin: 0 auto; }
  h1 { font-size: 1.75rem; font-weight: 800; margin-bottom: 0.5rem; }
  .page-desc { color: var(--text-secondary); margin-bottom: 2rem; }
</style>
