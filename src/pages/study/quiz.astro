---
import BaseLayout from '../../layouts/BaseLayout.astro';
import QuizPanel from '../../components/study/QuizPanel.tsx';
import { getCollection } from 'astro:content';

const topics = await getCollection('topics');
const topicsJson = topics.map(t => t.data);
---

<BaseLayout title="Quiz — MEXT Physics" description="Practice quiz for MEXT Physics exam">
  <div class="page">
    <h1>Quiz Mode</h1>
    <p class="page-desc">Test yourself with timed multiple-choice questions from real exam problems.</p>
    <QuizPanel topics={topicsJson} client:visible />
  </div>
</BaseLayout>

<style>
  .page { max-width: 700px; margin: 0 auto; }
  h1 { font-size: 1.75rem; font-weight: 800; margin-bottom: 0.5rem; }
  .page-desc { color: var(--text-secondary); margin-bottom: 2rem; }
</style>
